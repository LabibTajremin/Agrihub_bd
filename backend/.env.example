# Environment overrides. Every config key maps to AGRI_<SECTION>_<KEY>.
# Secrets MUST be provided here (never in config.yaml).

# --- secrets ---
AGRI_DATABASE_URL=postgres://agri:agri@localhost:5432/agrismart?sslmode=disable
AGRI_REDIS_URL=
AGRI_AUTH_JWT_SECRET=change-me-to-a-random-string-of-32+-chars
AGRI_STORAGE_LOCAL_SIGNING_KEY=change-me-to-another-random-32+-chars
AGRI_STORAGE_S3_ACCESS_KEY=
AGRI_STORAGE_S3_SECRET_KEY=

# --- everything else (defaults shown) ---
AGRI_APP_NAME=agrismart
AGRI_APP_ENV=development
AGRI_APP_BASE_URL=http://localhost:8080
AGRI_HTTP_ADDR=:8080
AGRI_HTTP_READ_TIMEOUT=10s
AGRI_HTTP_WRITE_TIMEOUT=30s
AGRI_HTTP_IDLE_TIMEOUT=60s
AGRI_HTTP_REQUEST_TIMEOUT=15s
AGRI_HTTP_SHUTDOWN_TIMEOUT=20s
AGRI_HTTP_MAX_BODY_BYTES=1048576
AGRI_HTTP_CORS_ALLOWED_ORIGINS=*
AGRI_HTTP_TRUST_PROXY_HEADERS=true
AGRI_HTTP_RATE_LIMIT_PER_MINUTE=120
AGRI_HTTP_AUTH_RATE_LIMIT_PER_MINUTE=20
AGRI_DATABASE_POOL_MODE=transaction
AGRI_DATABASE_MAX_CONNS=10
AGRI_DATABASE_MIN_CONNS=0
AGRI_DATABASE_CONNECT_TIMEOUT=5s
AGRI_DATABASE_OUTBOX_BATCH_SIZE=100
AGRI_DATABASE_OUTBOX_POLL_INTERVAL=2s
AGRI_AUTH_JWT_KEY_ID=k1
AGRI_AUTH_ISSUER=agrismart
AGRI_AUTH_ACCESS_TTL=15m
AGRI_AUTH_REFRESH_TTL=720h
AGRI_AUTH_OTP_TTL=5m
AGRI_AUTH_OTP_LENGTH=6
AGRI_AUTH_OTP_MAX_ATTEMPTS=5
AGRI_AUTH_OTP_PER_NUMBER_PER_HOUR=5
AGRI_AUTH_OTP_PER_IP_PER_HOUR=20
AGRI_AUTH_ARGON2_TIME=1
AGRI_AUTH_ARGON2_MEMORY_KIB=65536
AGRI_AUTH_ARGON2_THREADS=2
AGRI_AUTH_ARGON2_KEY_LEN=32
AGRI_STORAGE_BACKEND=local
AGRI_STORAGE_LOCAL_DIR=var/media
AGRI_STORAGE_S3_ENDPOINT=localhost:9000
AGRI_STORAGE_S3_BUCKET=agrismart-media
AGRI_STORAGE_S3_REGION=us-east-1
AGRI_STORAGE_S3_USE_SSL=false
AGRI_STORAGE_PRESIGN_TTL=15m
AGRI_STORAGE_MAX_UPLOAD_BYTES=8388608
AGRI_STORAGE_ALLOWED_CONTENT_TYPES=image/jpeg,image/png,audio/mpeg,audio/ogg
AGRI_LOCALIZATION_DEFAULT_LANGUAGE=bn
AGRI_LOCALIZATION_CACHE_MAX_AGE=300s
AGRI_AI_PROVIDER=stub
AGRI_AI_MIN_DIAGNOSIS_CONFIDENCE=0.60
AGRI_ADVISORY_WEIGHT_SOIL=0.30
AGRI_ADVISORY_WEIGHT_WATER=0.25
AGRI_ADVISORY_WEIGHT_PEST=0.15
AGRI_ADVISORY_WEIGHT_MARKET=0.20
AGRI_ADVISORY_WEIGHT_SEED=0.10
AGRI_ADVISORY_TOP_N=5
AGRI_WEATHER_PROVIDER=stub
AGRI_WEATHER_BASE_URL=https://api.open-meteo.com
AGRI_WEATHER_HTTP_TIMEOUT=5s
AGRI_WEATHER_STALE_AFTER=3h
AGRI_WEATHER_BREAKER_FAILURE_THRESHOLD=3
AGRI_WEATHER_BREAKER_OPEN_TIMEOUT=30s
AGRI_WEATHER_BREAKER_HALF_OPEN_MAX_CALLS=1
AGRI_OBSERVABILITY_LOG_LEVEL=info
AGRI_OBSERVABILITY_LOG_FORMAT=json
AGRI_OBSERVABILITY_METRICS_ENABLED=true
AGRI_FEATURES_GUEST_MODE=true
AGRI_FEATURES_EXPOSE_OTP=false
